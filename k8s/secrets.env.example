# Template for the loan-approval-secrets Secret. It is NOT part of the
# kustomization, so `kubectl apply -k k8s` never ships credentials from git.
#
#   cp k8s/secrets.env.example k8s/secrets.env      # k8s/secrets.env is gitignored
#   # fill in every value, then:
#   kubectl create namespace loan-approval --dry-run=client -o yaml | kubectl apply -f -
#   kubectl -n loan-approval create secret generic loan-approval-secrets \
#     --from-env-file=k8s/secrets.env --dry-run=client -o yaml | kubectl apply -f -
#
# The backend refuses to start without DJANGO_SECRET_KEY, FIELD_ENCRYPTION_KEY
# and a broker URL. Never reuse example or "change-me" values.

# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
POSTGRES_USER=
POSTGRES_PASSWORD=
ANTHROPIC_API_KEY=
# Token Prometheus sends as X-Health-Token to scrape /metrics.
HEALTH_CHECK_TOKEN=
# Redis broker (db 0); the Django cache uses db 1 of the same URL. With
# terraform's ElastiCache (TLS + AUTH) use the rediss:// scheme, the auth
# token as the password and the `redis_primary_endpoint` output:
#   rediss://:<redis_auth_token>@<redis_primary_endpoint>:6379/0
CELERY_BROKER_URL=
# Optional: creates this admin account on the first db-migrate Job run.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
