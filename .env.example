# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=loan_approval
POSTGRES_USER=postgres
# Required — compose refuses to start without this.
# Generate: `openssl rand -base64 24` (or any strong secret).
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=change-me-to-a-strong-password

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
DJANGO_CACHE_URL=redis://redis:6379/1

# AI: runs locally on Llama 3.1 8B through Ollama by default ($0, nothing
# leaves your machine). Start the model server with the `ollama` profile:
COMPOSE_PROFILES=ollama
# The first start downloads the model (~5 GB) through the one-shot
# `ollama-init` service. Without Ollama running, the bias check falls back to
# its deterministic score and flagged emails wait for human review.

# Bias verdicts (the LLM only sees emails the deterministic pre-screen flagged
# as ambiguous): `ollama` (default) or `anthropic` (Claude, needs a key).
# Use an 8B model or larger: a 3B model passed blatantly discriminatory text as
# a false positive in testing.
BIAS_LLM_BACKEND=ollama
BIAS_OLLAMA_MODEL=llama3.1:8b
# Seconds one local verdict may take (stays below the email task's 300s limit).
BIAS_LLM_TIMEOUT=240

# Who writes customer-facing copy (decision emails, offer wording, marketing):
#   template (default) = no LLM; deterministic, compliance-checked templates.
#   ollama             = local model `loan-email` (Llama 3.1 8B, 16k context),
#                        slow on CPU (~1-2 min per email).
#   groq               = hosted Groq free tier (does not train on prompts), but
#                        its 6k tokens/min cap is too small for these prompts.
#   anthropic          = Claude, needs ANTHROPIC_API_KEY.
# The lending decision is deterministic ML either way, and any unreachable
# backend falls back to the template.
EMAIL_LLM_BACKEND=template
EMAIL_LLM_MODEL=
EMAIL_LLM_SEED=0
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: Claude. Only used when a backend above is set to `anthropic`.
ANTHROPIC_API_KEY=
# Senior bias-reviewer model when BIAS_LLM_BACKEND=anthropic.
BIAS_REVIEWER_MODEL=claude-opus-4-8

# Agent 2: rewrites a moderate-band flagged email once under a stricter check.
BIAS_AGENT2_ENABLED=true

# Demo mode: when set, every outbound email goes to this inbox instead of the
# applicant's address. Leave blank to email applicants.
EMAIL_REDIRECT_ALL_TO=

# Security
FIELD_ENCRYPTION_KEY=change-me-generate-with-python-c-from-cryptography.fernet-import-Fernet-print-Fernet.generate_key
# backend/entrypoint.sh creates this admin user on start; both values are required.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# Ops token for /metrics and /api/v1/health/deep/ (sent as the X-Health-Token
# header). Empty = only staff sessions can read them. Required by the
# monitoring profile: Prometheus reads it as a compose secret to scrape
# /metrics. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTH_CHECK_TOKEN=

# Django admin URL path (randomize in production, e.g. "my-secret-admin/")
DJANGO_ADMIN_URL=admin/

# Sentry (optional — leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Email (Gmail SMTP — generate an App Password at https://myaccount.google.com/apppasswords)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=aussieloanai@gmail.com

# Grafana (required only when running the monitoring profile)
# Compose refuses to start the monitoring stack without this; generate a strong password.
# Uncomment COMPOSE_FILE below to make monitoring stack commands one-liner friendly.
# COMPOSE_FILE=docker-compose.yml:docker-compose.monitoring.yml
GRAFANA_ADMIN_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SENTRY_DSN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Reverse-proxy hops in front of the backend that append to X-Forwarded-For.
# Rate limits key on the client IP derived from it. 0 = no proxy (compose
# publishes the backend directly); production settings default to 1 (k8s ingress).
# TRUSTED_PROXY_COUNT=0
